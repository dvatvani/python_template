[project]
name = "{{project_slug}}"
description = "{{project_description}}"
readme = { file = "README.md", content-type = "text/markdown" }
requires-python = "==3.15.*"
dependencies = []
version = "0.0.0"

[dependency-groups]
# Lower bounds only: exact versions are pinned in uv.lock (and bumped by Dependabot).
dev = [
    "commitizen>=4.19.3",
    "pre-commit>=4.7.0",
    "pytest-cov>=7.1.0",
    "pytest>=9.1.1",
    "ruff>=0.17.3",
    "ty>=0.0.92",
]

[tool.uv]
required-version = ">=0.13.0"
system-certs = true # Use the system certificate store

[build-system]
requires = ["uv_build>=0.13.6,<0.14.0"]
build-backend = "uv_build"

[project.urls]
"Homepage" = "https://github.com/{{github_username}}/{{project_slug}}"
"Source" = "https://github.com/{{github_username}}/{{project_slug}}"

[tool.pytest]
testpaths = ["tests"]
# Error on unknown markers/config keys and treat unexpected xfail passes as failures
strict = true
addopts = [
    "-ra",
    "--cov={{project_slug_underscore}}",
    "--cov-report=term-missing",
]

[tool.coverage.run]
branch = true

[tool.ruff.lint]
# Defaults (pycodestyle errors, pyflakes) plus import sorting, pyupgrade, bugbear,
# simplifications, ruff-specific, pytest-style and comprehension rules.
select = ["E", "F", "W", "I", "UP", "B", "SIM", "RUF", "PT", "C4"]
# Line length is left to the formatter.
ignore = ["E501"]

[tool.commitizen]
version_provider = "uv"
tag_format = "v$version"
# Annotated tags are what `git push --follow-tags` (in `just release`) pushes
annotated_tag = true
# Stay on 0.x until you deliberately bump to 1.0.0 (`just release --increment MAJOR`)
major_version_zero = true
update_changelog_on_bump = true
